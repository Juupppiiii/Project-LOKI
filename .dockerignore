# Never send workstation state or secrets to the Docker daemon.
.git
.gitignore
.env
.env.*
!.env.example
.venv
.vscode
.kiro
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache

# UI is built from its lockfile inside the image.
overlay/ui/node_modules
overlay/ui/dist
# The .npmrc carries a workstation-specific cafile path and registry pin.
# The Dockerfile sets the registry explicitly (NPM_REGISTRY build arg), so keep
# this file out of the build context to avoid a conflicting config.
overlay/ui/.npmrc

# Operational scripts, docs, and tests are not part of the runtime image.
scripts
docs
tests
README.md

# Local state and generated artifacts.
*.db
*.db-*
*.duckdb
output
infra/node_modules
infra/cdk.out

# Raw discovery exports are not web-runtime dependencies.
data/*
!data/incidents.csv
automation_candidates.csv
