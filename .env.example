# Bucky RAG — environment configuration
# Copy to .env and fill in your values.

# AWS credentials for Bedrock (Claude)
AWS_PROFILE=devops
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.anthropic.claude-opus-5

# ServiceNow (read-only ticket pulling)
SN_INSTANCE=tpicapdev.service-now.com
SN_USERNAME=your-readonly-account
SN_PASSWORD=your-password

# Vector store path (local ChromaDB)
CHROMA_PERSIST_DIR=data/index/chroma

# Server
BUCKY_HOST=127.0.0.1
BUCKY_PORT=8800
