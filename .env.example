# Copy this file to .env and fill in local development values.
# src/config.py loads .env for discovery/ServiceNow settings. Core overlay
# settings should be exported into the process/container environment explicitly.

# ServiceNow connection
SN_INSTANCE=https://tpicapdev.service-now.com
SN_USERNAME=api_read_only
SN_PASSWORD=replace-with-read-only-servicenow-password

# LOKI execution boundary. `simulation` (default) touches nothing. `live` is the
# only other accepted value; it registers reviewed real connectors, but each is
# still gated to one allowlisted action binding and its own write switch. Any
# other value fails at startup.
LOKI_EXECUTION_MODE=simulation

# -- Real connectors (dormant unless live mode is on) -------------------------
# The ServiceNow work-note connector is the first real connector. It needs BOTH
# live mode above AND the write switch below before it posts anything. With live
# mode on but the write switch off, it runs in dry-run (validates + reports what
# it WOULD post, makes no write). Credentials are the SERVICENOW_*/SN_* values
# above; use a WRITE-capable service account against a dev/sandbox instance.
# LOKI_SERVICENOW_WRITE_ENABLED=0
# LOKI_SERVICENOW_TABLE=incident

# -- Governance controls ------------------------------------------------------
# Separation of duties: the person who approved a chunk cannot also trigger its
# execution. On by default; set 0 only on a single-user dev box.
# LOKI_ENFORCE_SOD=1
# Approval expiry in seconds (0 disables). An older approval must be renewed.
# LOKI_APPROVAL_TTL_SECONDS=3600
# Advisory semantic suggestions (/api/suggest). Authorises nothing; 0 disables.
# LOKI_SEMANTIC_SUGGESTIONS=1

# -- Advisory LLM knowledge base (/api/recommend-steps) -----------------------
# When enabled, step recommendations are synthesised by a Claude model on Amazon
# Bedrock, grounded in real solved-ticket history (RAG). STRICTLY ADVISORY: the
# model approves and executes nothing and never changes the authoritative match.
# Off by default: without this the endpoint returns the real retrieved grounding
# and says no live model is attached (it never makes a paid call unprompted).
# LOKI_LLM_ENABLED=0
# Model id: set to the newest Claude available in your Bedrock region.
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# -- Authentication -----------------------------------------------------------
# Who is signing in. Two modes, chosen automatically:
#   * Entra ID (OIDC)  -- the real path, used when the three Entra values below
#                         are all set. ID tokens are RS256-verified against the
#                         tenant JWKS; issuer, audience, expiry and nonce are
#                         checked before any claim is trusted.
#   * Dev login        -- a local email+role fallback, available ONLY when Entra
#                         is NOT configured and OVERLAY_ALLOW_DEV_LOGIN != 0.
#
# Session cookie signing key. If unset, a random per-process key is used, which
# logs everyone out on restart. Set a stable secret for any shared deployment.
# LOKI_SECRET_KEY=generate-a-long-random-string
# LOKI_SESSION_MAX_AGE=28800            # seconds (default 8h)

# Entra app registration (created by your Entra admins). All three are required
# to switch on the real auth path.
# LOKI_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# LOKI_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# LOKI_ENTRA_CLIENT_SECRET=resolve-from-secrets-manager
# LOKI_ENTRA_REDIRECT_URI=http://127.0.0.1:8800/api/auth/callback

# How long a fetched JWKS is reused before refetch (seconds). Unknown-kid key
# rollover is handled automatically regardless of this value.
# LOKI_JWKS_CACHE_SECONDS=3600

# Map Entra group object-ids or app-role names to LOKI roles. Unmapped users
# fall back to LOKI_DEFAULT_ROLE. Format: "value=role,value=role".
# LOKI_ENTRA_ROLE_MAP=grp-approvers=approver,grp-admins=admin
# LOKI_DEFAULT_ROLE=operator

# Dev login escape hatch. Ignored entirely when Entra is configured.
# OVERLAY_ALLOW_DEV_LOGIN=1

# Persistence. SQLite remains the safe local default.
LOKI_STORE_BACKEND=sqlite
OVERLAY_DB=overlay_tasks.db

# PostgreSQL production settings (export these only when selecting postgres).
# LOKI_STORE_BACKEND=postgres
# LOKI_POSTGRES_HOST=loki-proxy.cluster-xxxxxxxx.region.rds.amazonaws.com
# LOKI_POSTGRES_PORT=5432
# LOKI_POSTGRES_DB=loki
# LOKI_POSTGRES_USER=loki_app
# LOKI_POSTGRES_PASSWORD=resolve-from-secrets-manager
# LOKI_POSTGRES_SSLMODE=require
# LOKI_POSTGRES_POOL_MIN=1
# LOKI_POSTGRES_POOL_MAX=10
# LOKI_POSTGRES_AUTO_MIGRATE=0

# Optional extraction tuning (defaults shown)
# LOKI_LIVE_LEASE_TTL_SECONDS=120
# SN_PAGE_SIZE=5000
# SN_MAX_RETRIES=3
# SN_RETRY_BACKOFF=2.0
# SN_REQUEST_TIMEOUT=120
# SN_MAX_PAGES=1000
# Rolling date window (months) applied to tables with a date filter, e.g. incident
# SN_DATE_WINDOW_MONTHS=3

# Optional paths (defaults shown)
# SN_OUTPUT_DIR=data
# SN_ANALYSIS_DIR=output
# SN_DUCKDB_PATH=automation_discovery.duckdb
