# The public npm registry is blocked on this network (403). Packages come from
# the internal Nexus mirror instead -- the same host already present in this
# machine's npm cache.
#
# Scoped to this project on purpose: the user-level ~/.npmrc is left alone, and
# its cafile setting (corporate TLS bundle) still applies because npm merges
# project and user config.
registry=https://nexus.tpicapcloud.com/repository/npm-group/
